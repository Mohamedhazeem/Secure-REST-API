{
  "info": {
    "_postman_id": "e4da44e4-fc3c-4658-bcf3-e777e7d3a741",
    "name": "Auth",
    "description": "Authentication endpoints for TrustFeed. Covers registration, login, token refresh, logout, account deletion, and session management. Tokens are issued as HTTP-only cookies (access_token, refresh_token) and are sent automatically by Postman for the same origin. Run Register or Login first to obtain the cookies used by the authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "51054906"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1430/api/v1",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "64f7c2b5e4b0c2a5f8d9e1ca",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" },
          { "key": "Accept", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"securePassword1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "protocol": "http",
          "host": ["localhost"],
          "port": "1430",
          "path": ["api", "v1", "auth"]
        }
      },
      "response": [
        {
          "name": "User created",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"User registered successfully\",\n  \"user\": {\n    \"_id\": \"64f7c2b5e4b0c2a5f8d9e1c3\",\n    \"id\": \"64f7c2b5e4b0c2a5f8d9e1c3\",\n    \"username\": \"alice\",\n    \"email\": \"alice@example.com\"\n  }\n}"
        }
      ]
    },
