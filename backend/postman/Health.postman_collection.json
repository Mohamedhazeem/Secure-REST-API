{
  "info": {
    "_postman_id": "e5f7a9b1-c3d4-4e5f-b061-5c3d4e5f6a7b",
    "name": "Health",
    "description": "Health probes for TrustFeed. Liveness and readiness endpoints are unprotected and require no authentication. Readiness verifies MongoDB and Redis connectivity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "51054906"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1430/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "1430",
          "path": ["api", "v1", "health"]
        }
      },
      "response": [
        {
          "name": "Alive",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"ok\",\n  \"uptime\": 123.45,\n  \"timestamp\": \"2026-08-10T12:00:00.000Z\"\n}"
        }
      ]
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
        "url": {
          "raw": "{{baseUrl}}/health/ready",
          "protocol": "http",
          "host": ["localhost"],
          "port": "1430",
          "path": ["api", "v1", "health", "ready"]
        }
      },
      "response": [
        {
          "name": "Ready",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"ready\",\n  \"dependencies\": {\n    \"mongodb\": { \"status\": \"up\" },\n    \"redis\": { \"status\": \"up\" }\n  },\n  \"timestamp\": \"2026-08-10T12:00:00.000Z\"\n}"
        }
      ]
    }
  ]
}
